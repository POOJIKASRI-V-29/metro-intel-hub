# ── KMRL Document Intelligence — environment template ──
# Copy to `.env` and adjust. Never commit the real `.env`.

# --- API server (config/settings.py, prefix SERVER_) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Pre-warm the ML backends on startup (loads the embedding model, opens Qdrant/LLM).
# Leave 0 for fast dev boots; set 1 in production.
PREWARM=0

# --- LLM (config/settings.py, prefix LLM_) ---
LLM_ACTIVE_PROVIDER=ollama            # ollama | openai
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.1:8b
LLM_OPENAI_API_KEY=                   # required only when LLM_ACTIVE_PROVIDER=openai
LLM_OPENAI_MODEL=gpt-4o-mini

# Consumed directly by src/llm/llm_client.py (OpenAI-compatible client):
OLLAMA_API_KEY=ollama-local-bypass-key

# --- Embeddings (config/settings.py, prefix EMBEDDING_) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu                  # cpu | cuda | mps
EMBEDDING_VECTOR_DIMENSION=384

# --- Vector store ---
# Consumed by src/api/dependencies.py (Qdrant provider):
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# config/settings.py Chroma settings (prefix VECTOR_DB_):
VECTOR_DB_PERSIST_DIRECTORY=./data/chroma
VECTOR_DB_COLLECTION_NAME=kmrl_documents

# --- OCR (config/settings.py, prefix OCR_) ---
OCR_PROVIDER=paddle                   # paddle | tesseract

# --- Logging (config/settings.py, prefix LOG_) ---
LOG_LEVEL=INFO
