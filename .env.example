# KMRL Document Intelligence: backend environment. Copy to .env and adjust.
# Values shown are the defaults the code uses when a variable is unset.

# --- Vector store (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Leave empty for a local, unauthenticated Qdrant.
QDRANT_API_KEY=

# --- LLM (config/settings.py, LLM_ prefix) ---
# "ollama" for a local Ollama server, otherwise an OpenAI-compatible endpoint.
LLM_ACTIVE_PROVIDER=ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.1:8b
# Used when LLM_ACTIVE_PROVIDER is not ollama.
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Ollama ignores the key, but the client needs a non-empty one.
OLLAMA_API_KEY=ollama-local-bypass-key

# --- Startup ---
# Set to 1 to load the embedding model at boot instead of on the first request.
PREWARM=0

# --- Hosting ---
# Port the container listens on (Dockerfile CMD).
PORT=8000
